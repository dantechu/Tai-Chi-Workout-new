# RevenueCat API Keys (Public Keys from Dashboard)
# Get these from: https://app.revenuecat.com/settings/api-keys
REVENUECAT_IOS_API_KEY=your_ios_api_key_here
REVENUECAT_ANDROID_API_KEY=your_android_api_key_here

# Optional: For Amazon Appstore support
# REVENUECAT_AMAZON_API_KEY=your_amazon_api_key_here

# RevenueCat Configuration
REVENUECAT_ENTITLEMENT_ID=premium
REVENUECAT_OFFERING_ID=default
